PORT=5000

# SMTP connection
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# If true use SSL (port 465). If false, STARTTLS (port 587) is used.
SMTP_SECURE=false

# require STARTTLS when secure=false
SMTP_REQUIRE_TLS=true

# When false Node will accept self-signed certificates (local dev only!)
SMTP_REJECT_UNAUTHORIZED=true

FROM_EMAIL=info@craftydesignstudio.co.za

# CORS origin
CLIENT_ORIGIN=https://www.craftydesignstudio.co.za

# Development note: a local `.env.local` file may be created to override values locally.
# In development or when running `npm start`, the server will accept any localhost origin
# (e.g. http://localhost:3000, http://127.0.0.1:5173) to make testing easier.
