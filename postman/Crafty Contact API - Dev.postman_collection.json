{
  "info": {
    "name": "Crafty Contact API - Dev",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Send Contact (local)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Local Tester\",\n  \"email\": \"local@example.com\",\n  \"phone\": \"0000000000\",\n  \"subject\": \"Dev Test\",\n  \"message\": \"Testing local API\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/contact",
          "protocol": "http",
          "host": [ "localhost" ],
          "port": "5000",
          "path": [ "api", "contact" ]
        }
      }
    }
  ]
}
